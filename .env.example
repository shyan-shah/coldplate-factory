# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Model used by all agents (any Claude model ID).
CLAUDE_MODEL=claude-opus-5-5
# Effort for the agents: low | medium | high. Low keeps a live demo run to a few minutes.
AGENT_EFFORT=low
# Campaign Planner agent effort (it does the most reasoning).
PLANNER_AGENT_EFFORT=medium
# Agent mode: auto (live if a key is set, else scripted) | live | scripted
AGENT_MODE=auto
# Seconds between scripted-mode steps (makes the replay watchable).
SCRIPTED_STEP_DELAY=0.6
